# MessMate Backend Environment Variables Template
PORT=5000
NODE_ENV=production
# MongoDB Atlas Connection URI: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/messmate?retryWrites=true&w=majority
MONGODB_URI=
# Cryptographically secure random JWT secret (e.g. 64-char string)
JWT_SECRET=
# Frontend domain URL on Vercel for CORS security (e.g. https://your-messmate-frontend.vercel.app)
FRONTEND_URL=
